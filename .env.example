# Wall-clock timezone (IANA name). Everything the brain SAYS about time is
# local; everything it STORES stays UTC. Leave this unset and the container runs
# UTC, so the brain's "today" flips hours before the local one does — in
# America/Detroit it believes it is tomorrow from 20:00 onward, and dates notes,
# news searches, and chat answers accordingly. BRAIN_TIMEZONE overrides TZ for
# the brain's own clock if the image's zone must differ.
TZ=America/Detroit
# BRAIN_TIMEZONE=America/Detroit

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=bge-m3:latest
# How long Ollama keeps a model in VRAM after a request (Go duration).
# Chain steps run serially with gaps; at Ollama's 5m default the model is often
# evicted between steps of the same chain and reloaded each time.
# "-1m" pins indefinitely. Unset = Ollama's default. Malformed values are ignored.
OLLAMA_KEEP_ALIVE=30m
# Ollama Cloud: set OLLAMA_API_KEY and change OLLAMA_URL to https://ollama.com
# Get a key at https://ollama.com/settings/keys
# OLLAMA_API_KEY=

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty

# MCP Transport Configuration
MCP_TRANSPORT=stdio
# MCP_HTTP_BIND=127.0.0.1:3000
# MCP_API_KEY=your-secret-api-key

# Secret Provider Configuration
# Options: local, vault, aws, none
SECRET_PROVIDER=local

# Local Secret Provider (AES-256-GCM encrypted file)
SECRETS_FILE=.secrets.enc
# IMPORTANT: Set a strong encryption key for production!
# SECRETS_ENCRYPTION_KEY=your-strong-encryption-key-here

# HashiCorp Vault Provider
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=your-vault-token
# VAULT_MOUNT_PATH=secret
# VAULT_NAMESPACE=your-namespace  # Optional, for Vault Enterprise

# AWS Secrets Manager Provider
# AWS_REGION=us-east-1
# AWS_SECRET_PREFIX=/agent-brain/  # Optional prefix for secret names

# LLM Provider Configuration
# Options: ollama (default), anthropic, gemini
LLM_PROVIDER=ollama

# Anthropic Configuration
# ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Gemini Configuration
# GEMINI_API_KEY=your-api-key
# GEMINI_MODEL=gemini-1.5-pro

# vLLM / OpenAI-compatible Configuration (LLM_PROVIDER=vllm)
# Works with: vLLM, LM Studio, Jan.ai, LocalAI, Groq, Together AI, etc.
#
# Recommended models (brain research 2026-03-03):
#   8 GB GPU  (RTX 3060 Ti / 3090):  Qwen/Qwen3-8B-AWQ  (--max-model-len 4096)
#   24 GB GPU (RTX 4090):             Qwen/Qwen3-8B  or  Qwen/Qwen2.5-14B-Instruct-AWQ
#   80 GB GPU (A100 / H100):          Qwen/Qwen3-32B
#
# Serve the primary model (tool-use / reasoning):
#   vllm serve Qwen/Qwen3-8B-AWQ --enable-auto-tool-choice --tool-call-parser hermes \
#              --max-model-len 4096 --gpu-memory-utilization 0.80
#
# VLLM_URL=http://localhost:8000
# VLLM_MODEL=Qwen/Qwen3-8B-AWQ
# VLLM_API_KEY=                        # optional; for secured deployments
#
# Dedicated embedding endpoint (BAAI/bge-m3, 1024-dim, matches Neo4j vector index):
#   vllm serve BAAI/bge-m3 --task embed \
#              --hf-overrides '{"architectures": ["BgeM3EmbeddingModel"]}' \
#              --max-model-len 8192 --device cpu --port 8001
#
# VLLM_EMBED_URL=http://localhost:8001
# VLLM_EMBED_MODEL=BAAI/bge-m3

# Sleep / Training Data Export
# DATASET_DIR=./datasets
# TELEMETRY_DB_PATH=brain_logs.db  # Enable DuckDB interaction logging (required for SleepSkill)

# Web Search (search_web tool)
#
# search_web tries engines in order until one answers, so no single exhausted
# quota fails the call. The default first rung is the self-hosted SearXNG
# compose sidecar, which needs no key and has no quota — the keyed engines
# below are backstops. Free tiers are small: SerpApi is 100/month and Google
# CSE is 100/day, against a measured brain workload of 11-20 searches/day.
# SEARCH_ENGINE_ORDER=searxng,google,serpapi,brave
# SEARXNG_URL=http://searxng:8080
# SEARXNG_SECRET=  # signs SearXNG session cookies; any long random string

# --- Code execution sandbox ---------------------------------------------------
# Endpoint of the `sandbox` compose sidecar that backs the `execute_code` tool.
# Leave unset and the tool is NOT registered — a deployment without the sandbox
# lacks the tool rather than failing every call. The sandbox runs on an
# `internal: true` network with no egress and holds none of these credentials.
# SANDBOX_URL=http://sandbox:8000
# SERPAPI_KEY=your-serpapi-key
# BRAVE_API_KEY=your-brave-api-key       # free tier discontinued Feb 2026
# GOOGLE_API_KEY=your-google-api-key     # requires Custom Search API enabled in GCP
# GOOGLE_CX=your-google-custom-search-engine-id

# Autonomous Scheduler
# SCHEDULER_INTERVAL_SECS=300  # How often the scheduler polls for pending tasks (seconds)
# SCHEDULER_ENABLED=true        # Set to false to start with scheduler disabled
# TASK_RETENTION_DAYS=30        # Delete completed/cancelled tasks older than this on sleep entry (0 = keep forever)

# Knowledge Graph Snapshots
# KNOWLEDGE_SNAPSHOT_DIR=./snapshots              # Directory for .json.gz snapshot files
# AUTO_SNAPSHOT_BEFORE_CONSOLIDATION=true         # Take snapshot before consolidate_memories runs
# AUTO_SNAPSHOT_BEFORE_PRUNE=false                # Take snapshot before prune_old_notes runs
# SNAPSHOT_RETENTION_DAYS=14                      # Delete snapshots older than this (0 = no age pruning)
# SNAPSHOT_MAX_FILES=50                           # Keep at most this many snapshots (0 = no count pruning)

# Context Profiles
# CONTEXTS_DIR=./contexts                         # Directory for YAML context profile files

# Codebase Self-Analysis (CodebaseSkill — 7 tools, local filesystem only)
# CODEBASE_DIR=/path/to/agent-brain    # Root of the codebase; auto-detected from Cargo.toml walk-up if unset
#
# GitHub API access is provided by the generic `http_request` tool with
# `context_name="github"`. The `github` ApiContext is seeded at boot and
# auto-injects the GITHUB_TOKEN env var as a Bearer token.
# GITHUB_TOKEN=ghp_...                 # GitHub personal access token (optional)

# ── Media Learning (watch & summarize videos) ──────────────────────────────
# Requires `yt-dlp` on PATH at runtime (captions + metadata). Whisper fallback
# (WHISPER_PROVIDER) is a Phase 4 seam — caption-less videos error cleanly.
# YT_DLP_PATH=yt-dlp                   # Path to the yt-dlp binary
# FFMPEG_PATH=ffmpeg                   # Path to ffmpeg (Whisper audio extraction, Phase 4)
# MEDIA_CAPTION_LANG=en                # Preferred caption language
# MEDIA_MAX_DURATION_SECS=10800        # Skip videos longer than this (0 = unlimited)
# MEDIA_WATCH_ENABLED=false            # Enable autonomous channel polling (poll_media_sources)
# SOURCES_MEDIA_DIR=sources-media      # MediaSource watchlist YAML dir (graph-owned after seed)
# WHISPER_PROVIDER=none                # none|whisper-local|openai|groq (Phase 4, not yet wired)
