{
  "type": "object",
  "properties": {
    "country": {
      "description": "Country name(s) in ACLED spelling, e.g. \"Ukraine\" or [\"Sudan\", \"Chad\"]. Omit for worldwide.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "event_type": {
      "type": "string",
      "enum": "${EVENT_TYPES}"
    },
    "actor": {
      "type": "string",
      "description": "Primary actor (actor1), partial match, e.g. \"Wagner\""
    },
    "admin1": {
      "type": "string",
      "description": "First-level region, partial match, e.g. \"Donetsk\""
    },
    "location": {
      "type": "string",
      "description": "Town or place, partial match"
    },
    "since": {
      "type": "string",
      "description": "Start date YYYY-MM-DD (default: `days` before `until`)"
    },
    "until": {
      "type": "string",
      "description": "End date YYYY-MM-DD (default: today)"
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650,
      "description": "Window length when `since` is not given (default 30)"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": "${MAX_LIMIT}",
      "description": "Max rows fetched (default 500); a full page is reported as truncated"
    },
    "sample": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50,
      "description": "Sample events returned (default 15)"
    }
  }
}
