{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "list",
        "get",
        "write",
        "delete"
      ]
    },
    "name": {
      "type": "string",
      "description": "Bundle name, a slug (lowercase, digits, dashes)."
    },
    "description": {
      "type": "string",
      "description": "write: what the bundle is for (the owner reviews it by this)."
    },
    "requires": {
      "type": "object",
      "properties": {
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "description": "write: \"<kind>/<file>.yaml\" → the file (object or YAML text). The file name of a workflow or tool equals its `name`.",
      "additionalProperties": {
        "type": [
          "object",
          "string"
        ]
      }
    }
  },
  "required": [
    "action"
  ]
}
