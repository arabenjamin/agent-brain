{
  "type": "object",
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "search",
        "get",
        "write"
      ]
    },
    "query": {
      "type": "string",
      "description": "search: what you want to know."
    },
    "kind": {
      "type": "string",
      "enum": "${KINDS}"
    },
    "subsystem": {
      "type": "string",
      "description": "search: substring filter; write: the subsystem."
    },
    "path": {
      "type": "string",
      "description": "search: a file path the note names."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": "${MAX_LIMIT}"
    },
    "id": {
      "type": "string",
      "description": "get: the note; write: replace it (optional)."
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
